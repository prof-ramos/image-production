{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable observed Images catalog",
  "type": "object",
  "required": [
    "schema_version",
    "observed_at",
    "source_url",
    "evidence_type",
    "scope",
    "limitations",
    "cards"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "observed_at": {
      "const": "2026-10-20"
    },
    "source_url": {
      "const": "https://chatgpt.com/images/"
    },
    "evidence_type": {
      "const": "observed_ui"
    },
    "method": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cards": {
      "type": "array",
      "minItems": 56,
      "maxItems": 56,
      "items": {
        "type": "object",
        "required": [
          "name",
          "category",
          "kind",
          "prompt_observed",
          "prompt_status",
          "controls_observed",
          "flow_status",
          "source_refs"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "enum": [
              "Modelos",
              "Em alta"
            ]
          },
          "kind": {
            "enum": [
              "prompt_modal",
              "sketch_editor"
            ]
          },
          "prompt_observed": {
            "type": [
              "string",
              "null"
            ]
          },
          "prompt_status": {
            "type": "string"
          },
          "controls_observed": {
            "type": "object"
          },
          "flow_status": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "question_observations": {
            "type": "object",
            "required": [
              "observed_at",
              "universal",
              "usage",
              "questions",
              "option_tables",
              "source_refs",
              "limitations"
            ],
            "properties": {
              "observed_at": {
                "type": "string"
              },
              "universal": {
                "const": false
              },
              "usage": {
                "const": "contextual_examples_not_requirements"
              },
              "questions": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "option_tables": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "bullet_items": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "response_markdown_observed": {
                "type": "string"
              },
              "response_text_scope": {
                "type": "string"
              },
              "initial_round_observed_fields": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "global_answer_option_observed": {
                "type": "string"
              },
              "choice_groups": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "inline_options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "group",
                    "kind",
                    "source_excerpt",
                    "items",
                    "universal"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "group": {
                      "type": "string"
                    },
                    "kind": {
                      "const": "illustrative_alternatives_in_prose_not_exhaustive"
                    },
                    "source_excerpt": {
                      "type": "string"
                    },
                    "source_json_pointer": {
                      "type": "string"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "universal": {
                      "const": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "inline_options_status": {
                "type": "string"
              },
              "probe_mode": {
                "type": "string"
              },
              "prompt_delta": {
                "type": "string"
              },
              "submission_method": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "clarification_instruction": {
            "enum": [
              "explicit_in_observed_prompt",
              "explicit_followup_then_render_in_observed_prompt",
              "no_explicit_clarification_wording_in_observed_prompt"
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "sketch_editor"
                }
              }
            },
            "then": {
              "properties": {
                "prompt_observed": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "prompt_observed": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
