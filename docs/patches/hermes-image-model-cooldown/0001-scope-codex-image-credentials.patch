index 0000000000000000000000000000000000000000..65a4bf471a0437880bdab6b76931cb48202deae8
--- /dev/null
+++ b/tests/plugins/image_gen/test_codex_image_model_cooldown.py
@@ -0,0 +1,93 @@
+"""Image-provider selection must honor the requested model, not sibling benches."""
+import importlib
+import json
+import socket
+import time
+
+import pytest
+
+plugin = importlib.import_module('plugins.image_gen.openai-codex')
+TOKEN = 'synthetic-image-model-scope-token'
+BASE = 'https://images.example.test/backend-api/codex'
+
+
+def refuse_network(*args, **kwargs):
+    raise AssertionError('Offline image credential regression attempted network I/O')
+
+
+@pytest.fixture
+def pool_login(tmp_path, monkeypatch):
+    monkeypatch.setenv('HERMES_HOME', str(tmp_path))
+    monkeypatch.delenv('HERMES_CODEX_BASE_URL', raising=False)
+    monkeypatch.delenv('OPENAI_API_KEY', raising=False)
+    monkeypatch.delenv('OPENAI_IMAGE_MODEL', raising=False)
+    monkeypatch.setattr(socket, 'create_connection', refuse_network)
+    monkeypatch.setattr(socket, 'getaddrinfo', refuse_network)
+    from hermes_cli import auth
+    monkeypatch.setattr(auth, '_import_codex_cli_tokens', lambda: None)
+    return tmp_path / 'auth.json'
+
+
+def seed(path, benched):
+    path.write_text(json.dumps({'version': 1, 'providers': {},
+        'credential_pool': {'openai-codex': [{
+            'id': 'image-test-0', 'label': 'synthetic', 'auth_type': 'oauth',
+            'priority': 0, 'source': 'manual:device_code',
+            'access_token': TOKEN, 'refresh_token': 'synthetic-refresh-token',
+            'expires_at_ms': 4_000_000_000_000, 'base_url': BASE,
+            'model_cooldowns': {benched: time.time() + 365 * 24 * 60 * 60},
+        }]}}))
+
+
+def saved_sensitive_state(path):
+    row = json.loads(path.read_text())['credential_pool']['openai-codex'][0]
+    return {key: row.get(key) for key in
+            ('access_token', 'refresh_token', 'model_cooldowns', 'base_url')}
+
+
+@pytest.mark.parametrize('benched,available', [('other-chat-model', True), (plugin.API_MODEL, False)])
+def test_native_image_availability_honors_only_its_model(pool_login, benched, available):
+    seed(pool_login, benched)
+    before = saved_sensitive_state(pool_login)
+    provider = plugin.OpenAICodexImageGenProvider()
+    assert provider.is_available() is available
+    token, base = plugin._read_codex_credential()
+    if available:
+        assert token == TOKEN
+        assert base == BASE
+    else:
+        assert token is None
+    assert saved_sensitive_state(pool_login) == before
+
+
+def test_requested_model_bench_cannot_be_bypassed_by_legacy_singleton(pool_login, monkeypatch):
+    from agent import auxiliary_client
+    seed(pool_login, plugin.API_MODEL)
+    before = saved_sensitive_state(pool_login)
+    monkeypatch.setattr(auxiliary_client, '_read_codex_singleton_token', lambda: TOKEN)
+    assert plugin.OpenAICodexImageGenProvider().is_available() is False
+    assert saved_sensitive_state(pool_login) == before
+
+
+def test_image_request_keeps_selected_credential_on_its_endpoint(pool_login, monkeypatch):
+    import base64
+    import httpx
+    seed(pool_login, 'other-chat-model')
+    before = saved_sensitive_state(pool_login)
+    requests = []
+    # Synthetic 1x1 PNG response; this is not generated artwork or visual QA.
+    raw = bytes.fromhex('89504e470d0a1a0a0000000d49484452000000010000000108060000001f15c4'
+                        '890000000d49444154789c6300010000000500010d0a2db40000000049454e44ae426082')
+    def respond(request):
+        requests.append(request)
+        return httpx.Response(200, json={'data': [{'b64_json': base64.b64encode(raw).decode()}]})
+    real_client = httpx.Client
+    monkeypatch.setattr(httpx, 'Client', lambda **kwargs: real_client(
+        **kwargs, transport=httpx.MockTransport(respond)))
+    result = plugin.OpenAICodexImageGenProvider().generate('Synthetic fixture only')
+    assert result['success'] is True
+    assert len(requests) == 1
+    assert str(requests[0].url) == BASE + '/images/generations'
+    assert requests[0].headers['Authorization'] == 'Bearer ' + TOKEN
+    assert json.loads(requests[0].content)['model'] == plugin.API_MODEL
+    assert saved_sensitive_state(pool_login) == before
