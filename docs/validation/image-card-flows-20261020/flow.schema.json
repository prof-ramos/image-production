{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Images card flow evidence",
  "description": "Bounded runtime observations; inferred behavior and user examples remain separate. Does not establish universal branch coverage.",
  "type": "object",
  "required": [
    "observed_at",
    "source_url",
    "method",
    "card",
    "observed",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "observed_at": {
      "type": "string",
      "format": "date"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "conversation_url": {
      "type": "string",
      "format": "uri"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "card": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "observed": {
      "type": "object",
      "properties": {
        "card_description": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "pre_submit_controls": {
          "type": "object",
          "properties": {
            "aspect_ratio": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "default_aspect_ratio": {
              "type": "string",
              "minLength": 1
            },
            "suggested_photos": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "transition": {
          "type": "string",
          "minLength": 1
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        },
        "answers_submitted": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/answer"
              },
              {
                "type": "object",
                "properties": {
                  "other_fields": {
                    "type": "string",
                    "minLength": 1
                  },
                  "purpose": {
                    "type": "string",
                    "minLength": 1
                  },
                  "actual_ui_message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "patternProperties": {
                  "^q[0-9]+$": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "actual_ui_message"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "branches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/branch"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "global_answer_option": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "inferred": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "claim",
          "basis",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "user_provided_example_not_yet_observed": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "branch_coverage": {
      "type": "object",
      "properties": {
        "universal": {
          "const": false
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "observed_branch_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unexplored_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "universal",
        "scope",
        "observed_branch_ids",
        "unexplored_conditions"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "normalization": {
          "type": "string",
          "minLength": 1
        },
        "user_example_status": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "user_provided_example": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "accessibility",
            "screenshot",
            "conversation_text",
            "action_record"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "reference",
        "description"
      ],
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "option_selected",
            "text_equals",
            "text_contains",
            "other"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "question_id",
        "operator",
        "value",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "allows_free_text": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "when": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "details": {
          "type": "string",
          "minLength": 1
        },
        "follow_up": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    },
    "answer": {
      "type": "object",
      "properties": {
        "question_id": {
          "type": "string",
          "minLength": 1
        },
        "option_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "text": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "question_id",
        "evidence_refs"
      ],
      "additionalProperties": false
    },
    "branch": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "next_question_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observed_transition": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "conditions",
        "next_question_ids",
        "observed_transition",
        "evidence_refs"
      ],
      "additionalProperties": false
    }
  }
}
